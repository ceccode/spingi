# Copy to .env in this folder (runtime/) and fill in. .env is ignored by git: never commit a real key.
# Only ANTHROPIC_API_KEY and SPINGI_* variables are read from this file; anything else is ignored.
# Variables already exported in the shell take precedence over this file.

# Needed only by `spingi plan` and `spingi eval-planner`.
ANTHROPIC_API_KEY=
