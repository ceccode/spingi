{
  "$defs": {
    "CameraVideo": {
      "description": "A camera recorded continuously (`spingi run --camera-video`): frame i was taken at `start_t + i / fps`.",
      "properties": {
        "file": {
          "description": "the video, relative to the episode folder: head.mp4 (H.264)",
          "title": "File",
          "type": "string"
        },
        "camera": {
          "description": "the camera's name in the robot model: head",
          "title": "Camera",
          "type": "string"
        },
        "fps": {
          "description": "frames per second of simulated time",
          "title": "Fps",
          "type": "number"
        },
        "start_t": {
          "description": "simulated time of the first frame, on the axis of `t` and `sim_t`",
          "title": "Start T",
          "type": "number"
        },
        "frames": {
          "title": "Frames",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "camera",
        "fps",
        "start_t",
        "frames",
        "width",
        "height"
      ],
      "title": "CameraVideo",
      "type": "object"
    },
    "RobotInfo": {
      "properties": {
        "model": {
          "description": "robot profile name: unitree_g1, unitree_go2",
          "title": "Model",
          "type": "string"
        },
        "adapter": {
          "description": "e.g. fake, sim_mujoco; the real robot's adapter later",
          "title": "Adapter",
          "type": "string"
        }
      },
      "required": [
        "model",
        "adapter"
      ],
      "title": "RobotInfo",
      "type": "object"
    },
    "RunConfig": {
      "description": "What is needed to run the episode again (spingi replay). Optional: older episodes do not have it. Its fields\nhave the names and values of `SessionConfig`'s: an episode with a value the runtime does not know is refused.",
      "properties": {
        "perception_noise": {
          "default": 0.0,
          "description": "perceiver false-negative rate",
          "title": "Perception Noise",
          "type": "number"
        },
        "position_sigma_m": {
          "default": 0.0,
          "description": "perceiver position noise, metres",
          "title": "Position Sigma M",
          "type": "number"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "perception": {
          "default": "truth",
          "description": "truth (scene ground truth) or markers (AprilTags in frames)",
          "enum": [
            "truth",
            "markers"
          ],
          "title": "Perception",
          "type": "string"
        },
        "locomotion": {
          "default": "kinematic",
          "description": "kinematic (the base glides) or physics (the robot walks)",
          "enum": [
            "kinematic",
            "physics"
          ],
          "title": "Locomotion",
          "type": "string"
        },
        "odometry": {
          "default": "truth",
          "description": "truth (exact pose) or drift (the estimate drifts, ADR-0016)",
          "enum": [
            "truth",
            "drift"
          ],
          "title": "Odometry",
          "type": "string"
        },
        "camera_noise": {
          "default": false,
          "description": "blurred, noisy, JPEG-compressed head-camera frames",
          "title": "Camera Noise",
          "type": "boolean"
        }
      },
      "title": "RunConfig",
      "type": "object"
    }
  },
  "properties": {
    "format_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Format Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "description": "RFC 3339, UTC",
      "title": "Created At",
      "type": "string"
    },
    "robot": {
      "$ref": "#/$defs/RobotInfo"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "status": {
      "description": "success | aborted | invalid_plan | deadline | estop | error",
      "title": "Status",
      "type": "string"
    },
    "steps_completed": {
      "title": "Steps Completed",
      "type": "integer"
    },
    "steps_total": {
      "title": "Steps Total",
      "type": "integer"
    },
    "duration_s": {
      "description": "wall-clock time between run.start and run.end",
      "title": "Duration S",
      "type": "number"
    },
    "sim_time_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "total simulated time, if the adapter provides it",
      "title": "Sim Time S"
    },
    "sample_rate_hz": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "nominal sample rate of trajectory.jsonl",
      "title": "Sample Rate Hz"
    },
    "config": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "run settings, for replay"
    },
    "camera_video": {
      "anyOf": [
        {
          "$ref": "#/$defs/CameraVideo"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the head camera, recorded continuously"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "robot",
    "plan_id",
    "status",
    "steps_completed",
    "steps_total",
    "duration_s",
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
